# OPTIONAL. Every key below can be set in the app instead — the gear icon in the
# top bar — which is the easier path and needs no restart. This file is here for
# scripted deployments and for people who prefer it.
#
# Order of precedence: value set in the UI > this file / the environment > default.
# Missing integrations fall back to demo data.

# ---- Which model answers questions -------------------------------------
# anthropic (default) | openai | google | ollama | openai_compatible
# LLM_PROVIDER=anthropic

# Leave blank for the provider's default (claude-opus-5 / gpt-4o /
# gemini-2.5-pro / qwen3:8b).
# LLM_MODEL=

# Claude API key — used when LLM_PROVIDER=anthropic
# (or log in once with `ant auth login`, or set ANTHROPIC_AUTH_TOKEN)
ANTHROPIC_API_KEY=

# Key for OpenAI / Gemini / your own endpoint. A local Ollama needs none.
LLM_API_KEY=

# Needed for ollama and openai_compatible only. Examples:
#   http://localhost:11434                          Ollama (its default)
#   http://localhost:8000/v1                        vLLM / LM Studio / llama.cpp
#   https://<res>.openai.azure.com/openai/deployments/<dep>/chat/completions?api-version=2024-10-21
# LLM_BASE_URL=

# How the bot calls tools: auto (native, falling back to a prompted JSON
# protocol) | native | prompted. Small local models often need prompted.
# LLM_TOOL_MODE=auto

# Seconds to wait for a reply. Local models on CPU are slow; raise if needed.
# LLM_TIMEOUT=600

# HubSpot private app token (Settings -> Integrations -> Private Apps)
# Scopes needed: crm.objects.contacts.read, crm.objects.companies.read,
#                crm.objects.deals.read, tickets
HUBSPOT_TOKEN=

# Commit tickets back to HubSpot: auto (default) | manual | off.
# Tickets are always kept locally and mirrored to data/exports/tickets.csv.
# HUBSPOT_TICKET_SYNC=auto

# Microsoft 365 via an Entra ID app registration (client credentials flow)
# Application permissions needed (admin consented): Mail.Read, Mail.Send,
# Calendars.Read for the calendar tools, User.Read.All to list the tenant's
# mailboxes rather than only the ones named below.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# The default mailbox, used whenever a request doesn't name one,
# e.g. success@yourcompany.com
MS_MAILBOX=

# Further mailboxes the bot and the MCP server may read, comma-separated.
# Setting this makes it an allowlist: only these and MS_MAILBOX can be reached.
# Leave blank and any mailbox the app registration can see is available.
# MS_MAILBOXES=renewals@yourcompany.com,escalations@yourcompany.com

# Server
# HOST=0.0.0.0
# PORT=8300

# Optional components (spreadsheets, SQL drivers, decks) install from the
# Sources tab. Set this to 1 to disable that and install them by hand instead:
#   pip install -r requirements-optional.txt
# DISABLE_UI_INSTALL=

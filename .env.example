# Copy to .env and fill in what you have. Missing integrations fall back to demo data.

# Claude API — required for the chat bot (or log in once with `ant auth login`)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# HubSpot private app token (Settings -> Integrations -> Private Apps)
# Scopes needed: crm.objects.contacts.read, crm.objects.companies.read,
#                crm.objects.deals.read, tickets
HUBSPOT_TOKEN=

# Microsoft 365 via an Entra ID app registration (client credentials flow)
# Application permissions needed: Mail.Read, Mail.Send (admin consented)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# The mailbox the bot reads/replies from, e.g. success@yourcompany.com
MS_MAILBOX=

# Server
# HOST=0.0.0.0
# PORT=8300
